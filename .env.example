# ==============================================================================
# CivicFix Platform — Environment Configuration Template
# Copy this file to .env to customize settings for docker compose or local development.
# WARNING: Never commit .env or real production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=civicfix_db
POSTGRES_USER=civicfix_user
POSTGRES_PASSWORD=civicfix_dev_password_only
# Host port mapping for local database access (5433 avoids conflict with local PostgreSQL)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
# Active Spring profile: 'dev' enables local dev seed accounts; 'prod' enforces ProductionSafetyGuard
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BACKEND_PORT=8080

# Database connection settings (used for non-compose local runs; in compose, host is 'postgres')
DB_HOST=localhost
DB_PORT=5433
DB_NAME=civicfix_db
DB_USERNAME=civicfix_user
DB_PASSWORD=civicfix_dev_password_only

# Security & CORS configuration
FRONTEND_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173
SESSION_TIMEOUT_MINUTES=60
ALLOW_SEED_ACCOUNTS=true

# Storage directory for uploaded repair evidence
STORAGE_UPLOAD_DIR=/app/uploads/evidence

# SLA & Scheduler Configuration
SLA_ESCALATION_ENABLED=true
AUTO_CONFIRM_ENABLED=true
AUTO_CONFIRM_DAYS=7

# Evidence Location Verification Limits (meters)
EVIDENCE_MAX_DISTANCE=100.0
EVIDENCE_MAX_ACCURACY=100.0

# Reverse Proxy Security
# Set to 'true' when running behind a trusted reverse proxy (e.g. Nginx in docker-compose).
# When true, uses the last IP from X-Forwarded-For; when false, ignores proxy headers to prevent spoofing.
TRUSTED_PROXY_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Frontend Configuration (Nginx SPA Web Server)
# ------------------------------------------------------------------------------
# Exposed host port for Nginx web server (http://localhost:80)
FRONTEND_PORT=80

# Frontend API base URL (defaults to /api so Nginx reverse proxies to backend service)
VITE_API_BASE_URL=/api

# Interactive Persona Switcher (Development / Demo Only)
# When 'true', displays the quick role switcher in the bottom right corner for capstone evaluation.
# WARNING: MUST stay 'false' in production environments.
VITE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 4. Optional Multimodal Vision Triage Configuration
# ------------------------------------------------------------------------------
# Toggle vision model triage (default: false). When false, the deterministic rule engine runs as default.
AI_VISION_ENABLED=false
# Vision provider: 'gemini' (Google) or 'xai' (Grok). Default: gemini
AI_VISION_PROVIDER=gemini
# API Keys (placeholders only; never commit real credentials)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
XAI_API_KEY=your_xai_api_key_here
# Model names
AI_VISION_MODEL_GEMINI=gemini-1.5-flash
AI_VISION_MODEL_XAI=grok-2-vision-1212
# Call timeout in milliseconds (default: 10000ms / 10s)
AI_VISION_TIMEOUT_MS=10000
# Global daily request quota cap across all complaints (default: 200)
AI_VISION_DAILY_CAP=200

# ------------------------------------------------------------------------------
# 5. Outbound Mail & Password Recovery Configuration (Spring Mail)
# ------------------------------------------------------------------------------
# Set to 'true' to enable outbound SMTP delivery; 'false' simulates email in logs safely
CIVICFIX_MAIL_ENABLED=false
CIVICFIX_MAIL_FROM=noreply@civicfix.org
APP_BASE_URL=http://localhost:5173
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=smtp_username_placeholder
SPRING_MAIL_PASSWORD=smtp_password_placeholder
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
PASSWORD_RESET_TOKEN_VALIDITY_MINUTES=15

# ------------------------------------------------------------------------------
# 6. Public Map k-Anonymity Privacy & PDF Receipt Security Configuration
# ------------------------------------------------------------------------------
# Minimum number of complaints required in a spatial zone to render public map coordinates.
# If fewer than this threshold exist, coordinates are suppressed to protect resident privacy.
PUBLIC_MAP_MINIMUM_GROUP_SIZE=5

# HMAC Secret for Digital Tamper-Evident PDF Receipts (Must be configured in production)
CIVICFIX_RECEIPT_HMAC_SECRET=your_hmac_key_for_tamper_evident_receipts_min_32

# ------------------------------------------------------------------------------
# 7. Frontend Client & Firebase Configuration (Render Static Site)
# ------------------------------------------------------------------------------
# Backend API Base URL for Render Static Site
VITE_API_BASE_URL=https://civicfix-backend-wx6m.onrender.com/api
VITE_DEMO_MODE=false

# Frontend Vite variables (public client configuration)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=civicfix-15ee3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civicfix-15ee3
VITE_FIREBASE_STORAGE_BUCKET=civicfix-15ee3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_fcm_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Backend Spring Boot variables (Server-side Firebase Admin SDK)
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=civicfix-15ee3
# Provide either inline minified JSON string or path to service account key file
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# ------------------------------------------------------------------------------
# 8. Neon S3-Compatible Object Storage (Private Complaint Images)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=neon
NEON_STORAGE_BUCKET=civicfix-complaint-images
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=https://your-neon-endpoint.s3.us-east-2.amazonaws.com
AWS_ACCESS_KEY_ID=your_neon_storage_access_key_id
AWS_SECRET_ACCESS_KEY=your_neon_storage_secret_access_key

# ------------------------------------------------------------------------------
# 9. Resend Transactional Email API Configuration
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 10. Initial Platform Administrator Provisioning (Optional / First-Boot)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
